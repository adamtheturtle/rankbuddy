{
  "name": "rankbuddy-website-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Lint/validation tooling for the RankBuddy website and docs (docs/). Not part of the macOS app build.",
  "scripts": {
    "lint:html": "html-validate \"docs/**/*.html\"",
    "lint:css": "stylelint \"docs/**/*.css\"",
    "lint:md": "markdownlint-cli2 \"docs/**/*.md\"",
    "lint:links": "linkinator docs --recurse --verbosity error",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:md && npm run lint:links"
  },
  "devDependencies": {
    "html-validate": "^11.6.2",
    "linkinator": "^8.0.3",
    "markdownlint-cli2": "^0.23.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "fast-uri": "^4.1.2",
    "js-yaml": "^5.2.3",
    "postcss": "^8.5.25",
    "uuid": "^14.0.1"
  }
}
