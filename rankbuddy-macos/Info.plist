<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Partial Info.plist. GENERATE_INFOPLIST_FILE stays YES, so Xcode overlays the
  generated CFBundle* keys on top of this base at build time. This file carries the
  keys that can't be expressed as scalar INFOPLIST_KEY_* build settings: the
  NSServices array (#46), the NSUserActivityTypes array (#98), and the
  UTExportedTypeDeclarations array (#89).
-->
<plist version="1.0">
<dict>
	<!-- HTTPS API traffic uses only exempt, operating-system cryptography. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  The in-process favourite drag type (#89). FavoriteDrag.swift declares it with
	  UTType(exportedAs: "com.rankbuddy.favorite"); an exported type must be backed by
	  this declaration or the runtime won't register the identifier. The drag never
	  leaves the app, so it conforms only to public.data and carries no filename tags.
	-->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.rankbuddy.favorite</string>
			<key>UTTypeDescription</key>
			<string>RankBuddy Favourite</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<!--
	  Handoff / Continuity (#98). Declares the NSUserActivity type RankBuddy advertises
	  while viewing a test, question, or interview, so the system will Hand Off, surface
	  it in Spotlight, and offer it as a Siri Suggestion. Advertised in Handoff.swift;
	  continued in ContentView via onContinueUserActivity.
	-->
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.adamdangoor.rankbuddy.viewingItem</string>
	</array>
	<!--
	  The "Open in RankBuddy" macOS Service (#46). Lets a HackerRank URL selected
	  in any app deep-link into RankBuddy. The runtime handler is
	  ServicesProvider.openInRankBuddy(_:userData:error:), registered at launch via
	  NSApp.servicesProvider; this entry is what makes it appear in the Services menu.
	-->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Open in RankBuddy</string>
			</dict>
			<!-- The selector openInRankBuddy:userData:error: minus its standard suffix. -->
			<key>NSMessage</key>
			<string>openInRankBuddy</string>
			<key>NSPortName</key>
			<string>rankbuddy-macos</string>
			<!-- The handler reads the selected text (.string); a selected URL arrives as plain text. -->
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
