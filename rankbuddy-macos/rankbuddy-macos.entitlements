<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- RankBuddy talks to the HackerRank for Work API over HTTPS. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Favourites use NSUbiquitousKeyValueStore for cross-Mac synchronization.
	     Xcode expands these signing variables to the app's team-prefixed KVS container. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- Print / Save-as-PDF from the detail views (#13). Without this the sandbox
	     blocks NSPrintOperation with "This application does not support printing." -->
	<key>com.apple.security.print</key>
	<true/>
	<!-- Lets the user pick a destination via NSSavePanel for the CSV (#39) and Markdown
	     (#50) exports. Without it a sandboxed app traps in AppKit with
	     REPORT_APP_ENTITLEMENTS_INSUFFICIENT the moment a save panel is created. The
	     grant is scoped to what the user explicitly chooses in the panel — no broad
	     filesystem access. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Team-ID-prefixed App Group (not the bare "group." form): a notarized
	     Developer-ID build embeds no provisioning profile, and macOS only
	     authorizes a "group."-prefixed App Group when it's listed in the profile.
	     The "<TeamID>.group." form is authorized by matching the team-ID prefix to
	     the signing identity, so it needs no profile. Shared with a future widget. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>6L9H6Q8CUF.group.com.adamdangoor.rankbuddy</string>
	</array>
	<!-- No keychain-access-groups on purpose: it is a provisioning-profile-required
	     entitlement, and a Developer-ID build embeds no profile, so declaring it makes
	     AMFI refuse to launch the app. The account store uses the default access group
	     implicitly (KeychainStore pins its own service string). -->
</dict>
</plist>
