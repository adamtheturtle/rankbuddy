# macOS
.DS_Store

# Xcode — user-specific state
xcuserdata/
*.xcuserstate

# Build output / intermediates (also excluded from the lint configs)
DerivedData/
build/
build_release/
*.xcresult
.context/

# Node tooling for the website (docs/). package-lock.json IS committed (below);
# the installed tree is not.
node_modules/

# Swift Package Manager.
# NOTE: Package.resolved is intentionally NOT ignored — it is committed so a
# fresh checkout resolves the same package graph as CI (see docs/dependencies.md).
.swiftpm/
.build/

# Vale styles downloaded by `vale sync`.
styles/

# Compiler-backed analyzer diagnostics.
swiftlint-analyzer-findings.json

# Python script-test bytecode.
__pycache__/
