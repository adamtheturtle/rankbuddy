# SwiftFormat configuration.
#
# Pairs with .swiftlint.yml: SwiftFormat owns *formatting*, SwiftLint owns
# *correctness*. The two are kept non-overlapping so they never fight.
#
# Enforced in CI via `swiftformat . --lint --config .swiftformat` so a parent
# checkout cannot silently alter or exclude this repository.

--swiftversion 6.2

# Opt-in (default-off) rules we enable. Limited to safe, auto-applied formatting
# rules; rules that change semantics or identifiers (acronyms, preferFinalClasses,
# preferSwiftTesting, sortSwitchCases, propertyTypes) or cause large churn
# (organizeDeclarations, markTypes, wrapEnumCases) are deliberately left off.
# privateStateVariables is off for the same reason private_swiftui_state is
# disabled in SwiftLint: @State is shared across Type+Feature.swift files.
--enable blankLineAfterSwitchCase
--enable blankLinesAfterGuardStatements
--enable isEmpty
--enable noExplicitOwnership

# Keep SwiftFormat from fighting SwiftLint's default rules:
# SwiftLint's `trailing_comma` forbids trailing commas in collection literals,
# and its `opening_brace` requires the brace on the same line as the
# declaration (SwiftFormat's wrapMultilineStatementBraces would move it).
--trailing-commas never
--disable wrapMultilineStatementBraces

# Leave build output and SPM checkouts untouched.
--exclude .context,build_release,DerivedData
